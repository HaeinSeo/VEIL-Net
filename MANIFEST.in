include LICENSE README.md THIRD_PARTY_NOTICES.md
include .gitignore .gitattributes
recursive-include .github/workflows *.yml
recursive-include veil_net *.md
recursive-include configs *.yaml *.json
recursive-include figures *.png
recursive-include tests *.py
prune cache
prune checkpoints
prune results
prune releases
prune third_party
global-exclude __pycache__ *.py[cod]
